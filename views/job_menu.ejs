<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nu Empresas - Job</title>
    <link rel="stylesheet" href="job_menu.css">
    <link rel="icon" href="/img/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <div class="layout_wrapper">

        <!-- SIDEBAR ESQUERDA -->
        <aside class="painel_container">
            <div class="sidebar_header">
                <div class="icon_profile">
                    <img src="/img/do-utilizador.png" alt="">
                </div>
                <h1 class="greeting">Olá, Rafael</h1>
            </div>
            <!-- PAINEL DA SIDEBAR ESQUERDA -->
            <div class="painel_menu_container">
                <h1 class="menu_lat_item">Menu</h1>
                <button class="btn_menu_lat_item">
                    <img src="/img/app-wallet-passes.png" alt="">Trabalhos</button>
                <button class="btn_menu_lat_item">
                    <img src="/img/painel-de-controle.png" alt="">Dashboard</button>
                <button class="btn_menu_lat_item">
                    <img src="/img/transacao-de-dinheiro.png" alt="">Transações</button>
                <button class="btn_menu_lat_item">
                    <img src="/img/time-and-calendar.png" alt="">Calendário</button>
                <button class="btn_menu_lat_item">
                    <img src="/img/cliente.png" alt="">Clientes</button>
            </div>
        </aside>

        <!-- CONTEÚDO PRINCIPAL -->
        <div class="main_content">

            <!-- TOPBAR -->
            <div class="topbar">
                <a href="/" class="link_limpo">
                    <img class="icon_voltar" src="/img/proximo.png" alt="">
                    <span>Trabalhos</span>
                </a>
            </div>

            <hr class="linha_horizontal">

            <!-- BODY -->
            <div class="content_body">
                <h1 class="page_title">Trabalhos</h1>
                <div class="tab_container">

                    <button class="tab_item tab_item_active">Todos</button>
                    <button class="tab_item">Em andamento</button>
                    <button class="tab_item">Finalizados</button>
                    <button class="tab_item">Atrasados</button>
                    <button class="tab_item">Destacados</button>
                    <button class="tab_item">Propostas</button>


                    <div class="search_group">
                        <div class="input_wrapper">
                            <input type="text" placeholder="Pesquisar..." class="input_pesq">
                            <img src="/img/lupa.png" class="lupa_icon">
                        </div>
                        <button class="btn_export" onclick="abrirModal()">
                            <img src="/img/exportar.png" alt="">Criar
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <div id="modal_container" class="modal_overlay">
        <div class="modal_content">
            <h2 class="greeting_modal">Adicionar Trabalho</h2>
            <h2 class="titulo_modal">TÍTULO</h2>
            <input type="text" class="input_modal" placeholder="Ex: Redesing de Landing Page" id="nome_projeto">
            <h2 class="descricao_modal">DESCRIÇÃO</h2>
            <textarea name="" id="" class="input_modal_desc" placeholder="Descreva o escopo do trabalho..." id="descricao"></textarea>
            <h2 class="categoria_modal">CATEGORIA</h2>
            <div class="btn_modal_wrapper">
                <button class="ui_btn_modal active">UI/UX</button>
                <button class="frontend_btn_modal">Frontend</button>
                <button class="web_desing_btn_modal">Web Desing</button>
                <button class="backend_btn_modal">Backend</button>
                <button class="video_btn_modal">Video</button>
            </div>
            <div class="btn_modal_wrapper_down">
                <button class="outros_btn_modal">Outros</button>
            </div>
            <h2 class="titulo_modal">TIPO DE PAGAMENTO</h2>
            <div class="modal_wrapper_payment" id="tipo_cobranca">
                <button class="btn_payment_project active">Por Projeto</button>
                <button class="btn_payment_hour">Por Hora</button>
            </div>
            <div class="wrapper_payment">
                <h2 class="payment_valor">VALOR (R$/$)</h2>
                <h2 class="payment_data">PRAZO DE ENTREGA
                </h2>
            </div>
            <div class="payment_wrapper">
                <input type="text" class="input_valor" id="valor_projeto" placeholder="R$800.00">
                <input type="date" id="data_entrega" class="input_data">
            </div>

            <div class="btn_wrapper_payment">
                <button onclick="fecharModal()" class="btn_fechar">Fechar</button>
                <button onclick="fecharModal()" class="btn_salvar">Salvar</button>
            </div>

        </div>
    </div>
    <script>
        async function salvarTrabalhos() {
    const nome = document.getElementById('nome_projeto').value;
    const valor = document.getElementById('valor_projeto').value;
    const data_entrega = document.getElementById('data_entrega').value;
    const descricao = document.querySelector('.input_modal_desc').value;
    const btnCategoriaAtivo = document.querySelector('.btn_modal_wrapper .active, .btn_modal_wrapper_down .active');
    const categoria = btnCategoriaAtivo ? btnCategoriaAtivo.innerText : "Geral";
    const btnPagamentoAtivo = document.querySelector('.modal_wrapper_payment .active');
    const tipo_cobranca = btnPagamentoAtivo ? btnPagamentoAtivo.innerText : "Projeto";

    const response = await fetch('http://localhost:3000/job', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            nome, 
            valor, 
            data_entrega, 
            categoria, 
            tipo_cobranca, 
            descricao 
        })
    });

    if (response.ok) {
        const result = await response.json();
        console.log("Salvo com Sucesso", result);

        fecharModal();
        location.reload();
    }
}

        function abrirModal() {
            const modal = document.getElementById('modal_container');
            modal.classList.add('mostrar');
        }

        function fecharModal() {
            const modal = document.getElementById('modal_container');
            modal.classList.remove('mostrar');
        }

        document.querySelectorAll('.btn_payment_project, .btn_payment_hour').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.btn_payment_project, .btn_payment_hour')
                    .forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            });
        });

        document.querySelectorAll('.ui_btn_modal, .frontend_btn_modal, .web_desing_btn_modal, .backend_btn_modal, .video_btn_modal, .outros_btn_modal').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.ui_btn_modal, .frontend_btn_modal, .web_desing_btn_modal, .backend_btn_modal, .video_btn_modal, .outros_btn_modal')
                    .forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            });
        });
    </script>
</body>

</html>